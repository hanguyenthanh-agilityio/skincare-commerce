{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*", "../astro.config.mjs"],
  "exclude": ["dist"],
  "compilerOptions": {
    "types": ["node", "vitest/globals", "astro/client"],
    "moduleResolution": "bundler",
    "module": "esnext",
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  }
}
