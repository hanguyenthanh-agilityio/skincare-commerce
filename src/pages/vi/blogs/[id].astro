---
export const prerender = false;

// Layouts
import { BaseLayout } from '@/layouts';

// Constants
import { LOCALES } from '@/constants';

// Components
import { ContentBlock, StrapiImage } from '@/components';

// Sections
import { Blog, BlogDetailGallery, NotFound } from '@/sections';

// I18n
import { loadContent } from '@/i18n';

// Services
import { getBlogPageData } from '@/services';

// Types
import type { BlogContent, HomeContent, NotFoundContent } from '@/types';

const locale = LOCALES.VI;
const { id } = Astro.params;

// Load global content (safe)
const homePage = loadContent<HomeContent>('home', locale);
const blogPage = loadContent<BlogContent>('blog', locale);
const notFoundContent = loadContent<NotFoundContent>('404', locale);

// Fetch data
const result = await getBlogPageData(id, locale);

// Handle 404
if (result.pageNotFound) {
  Astro.response.status = 404;
}

const heroImage = result.blogDetail?.images?.[0];
---

<BaseLayout {locale}>
  {
    result.pageNotFound ? (
      <NotFound {...notFoundContent} />
    ) : (
      <div class="px-5">
        <div class="w-full flex flex-col justify-center items-center py-18 md:py-30">
          <ContentBlock
            title={result.blogDetail?.title ?? ''}
            description={result.blogDetail?.description ?? ''}
            align="center"
            colorScheme="dark"
            className="max-w-3xl"
          />
        </div>

        <StrapiImage
          image={heroImage}
          className="object-cover h-highlight-mobile md:h-highlight-xl lg:h-highlight-3xl w-full"
        />

        <BlogDetailGallery
          title={result.blogDetail?.title}
          description={result.blogDetail?.description}
          images={result.blogDetail?.images}
        />

        <Blog
          {...homePage.blog}
          blogs={result.blogs}
          ctaLabel={blogPage.ctaLabel}
          className="py-11 md:py-20"
        />
      </div>
    )
  }
</BaseLayout>
