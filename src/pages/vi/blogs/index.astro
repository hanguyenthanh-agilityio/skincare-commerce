---
// Layouts
import { BaseLayout } from '@/layouts';

// I18n
import { loadContent } from '@/i18n';

// Types
import type { HighlightSection, HomeContent } from '@/types';

import { Blog, Highlight, ArticleCard } from '@/sections';

// Constants
import { LOCALES } from '@/constants';

// Services
import { getBlogs } from '@/services';

const locale = LOCALES.VI;

const blogContent = loadContent<HomeContent>('home', locale);
const { highlight, ctaLabel } = loadContent<{ highlight: HighlightSection; ctaLabel: string }>(
  'blog',
  locale,
);

const { blog } = blogContent;

const { blogs } = await getBlogs({ locale });
---

<BaseLayout {locale}>
  <Highlight data={highlight} />

  <Blog {...blog} blogs={blogs} className="mx-5 md:mx-8 py-11 md:py-24" />

  {
    blogs.length > 0 && (
      <ArticleCard
        documentId={blogs[0].documentId}
        category={blogs[0].category}
        title={blogs[0].title}
        description={blogs[0].description}
        imageSrc={blogs[0].images[0]}
        ctaLabel={ctaLabel}
      />
    )
  }
</BaseLayout>
