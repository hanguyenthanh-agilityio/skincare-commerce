import { BaseLayout } from '@/layouts';

// Sections
import { Highlight } from '@/sections';

// I18n
import { loadPageContent } from '@/i18n';

// Types
import type { HighlightContent } from '@/types';

const locale = 'vi';
const page = loadPageContent<HighlightContent>('home', locale);
---

<BaseLayout>
  <Highlight data={page.highlight} />
</BaseLayout>
