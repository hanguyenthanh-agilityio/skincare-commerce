---
// Layouts
import { BaseLayout } from '@/layouts';

// Sections
import { UserVoice, Highlight, Feature, Quote, Product, Blog } from '@/sections';

// I18n
import { loadContent } from '@/i18n';

// Types
import type { HomeContent } from '@/types';

import { Carousel } from '@/sections';

// Constants
import { LOCALES } from '@/constants';

// Services
import { getBlogs, getProducts } from '@/services';

const locale = LOCALES.VI;

const page = loadContent<HomeContent>('home', locale);

const { carousel, feature, highlight, quote, product, blog } = page;

const { blogs } = await getBlogs({ locale });

const { products } = await getProducts({ locale });
---

<BaseLayout {locale}>
  <Carousel slides={carousel} client:load />

  <Feature
    data={feature}
    imageWrapperClass="h-highlight-mobile lg:h-highlight-lg xl:h-highlight-xl"
  />

  <Product
    {...product}
    products={products}
    limitDesktop={4}
    limitMobile={2}
    className="mx-5 md:mx-8"
  />

  <Highlight data={highlight} />

  <Quote
    title={quote.title}
    description={quote.description}
    className="py-15 px-5 md:px-15"
    sectionClassName="h-highlight-md md:h-highlight-lg"
  />
  <UserVoice />

  <Blog {...blog} blogs={blogs} className="mx-5 md:mx-8" />
</BaseLayout>
