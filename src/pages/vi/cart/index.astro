---
// Layouts
import { BaseLayout } from '@/layouts';

// I18n
import { loadContent } from '@/i18n';

// Types
import type { CartContent } from '@/types';

// Section
import { CartInfo } from '@/sections';

// Constants
import { LOCALES } from '@/constants';

// Service
import { getCartByUser } from '@/services';

const locale = LOCALES.VI;

const content = loadContent<CartContent>('cart', locale);

// Will update when handle Login
const USER_DOCUMENT_ID = 'vv32wq5ctzuk15aypvm747qd';

const items = await getCartByUser({
  userDocumentId: USER_DOCUMENT_ID,
});
---

<BaseLayout {locale}>
  <CartInfo content={content} items={items} client:load />
</BaseLayout>
