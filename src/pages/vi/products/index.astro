---
// Layouts
import { BaseLayout } from '@/layouts';

// Components
import { DropdownMenu, SortDropdown } from '@/components';

// Sections
import { Highlight } from '@/sections';

// I18n
import { loadContent } from '@/i18n';

// Types
import type { ProductContent } from '@/types';

// Constants
import { LOCALES } from '@/constants';

const locale = LOCALES.VI;

const productPage = loadContent<ProductContent>('products', locale);

const { highlight, sort, filterMenu } = productPage;
---

<BaseLayout {locale}>
  <Highlight data={highlight} />
  <div class="flex justify-between items-center bg-narvik h-18 pl-5">
    <DropdownMenu client:load data={filterMenu} className="flex gap-8" />
    <SortDropdown client:load content={sort} />
  </div>
</BaseLayout>
