---
// Layouts
import { BaseLayout } from '@/layouts';

// Sections
import { NotFound } from '@/sections';

// Constants
import { LOCALES } from '@/constants';

// Types
import type { NotFoundContent } from '@/types';

// I18n
import { loadContent } from '@/i18n';

const locale = Astro.url.pathname.startsWith('/vi') ? LOCALES.VI : LOCALES.EN;

Astro.response.status = 404;

const content = loadContent<NotFoundContent>('404', locale);
---

<BaseLayout {locale}>
  <NotFound {...content} />
</BaseLayout>
