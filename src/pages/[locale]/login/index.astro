---
import { isLocale, ROUTER } from '@/constants';

// Components
import { LoginForm, StrapiImage } from '@/components';
import { BaseLayout } from '@/layouts';

const { locale } = Astro.params;

if (!locale || !isLocale(locale)) {
  return Astro.redirect(ROUTER.NOT_FOUND);
}
---

<BaseLayout {locale}>
  <div class="flex">
    <!-- Image -->
    <div class="hidden md:block md:flex-1">
      <div class="relative overflow-hidden border bg-background min-h-hero-xl">
        <StrapiImage
          image={'https://www.gloskinbeauty.com/cdn/shop/articles/668448456942_0f2549ad-4f14-4e19-81c6-23fa6fca465d.jpg?v=1760637019'}
          className="absolute inset-0 h-full w-full object-cover"
          sizes="(min-width: 1024px) 60vw, 100vw"
          priority
        />
      </div>
    </div>

    <!-- Content -->
    <div class="md:flex-1 flex justify-center items-center py-10 px-5 md:px-20">
      <LoginForm {locale} client:load />
    </div>
  </div>
</BaseLayout>
