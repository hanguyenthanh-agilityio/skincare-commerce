---
export const prerender = false;

// Layouts
import { BaseLayout } from '@/layouts';

// Constants
import { isLocale, ROUTER } from '@/constants';

// Components
import { ContentBlock, StrapiImage } from '@/components';

// Sections
import { Blog, BlogDetailGallery } from '@/sections';

// I18n
import { buildRoute, loadContent } from '@/i18n';

// Services
import { getBlogPageData } from '@/services';

// Types
import type { HomeContent } from '@/types';

const { id, locale } = Astro.params;

if (!locale || !isLocale(locale)) {
  return Astro.redirect('/404');
}

// Load global content (safe)
const homePage = loadContent<HomeContent>('home', locale);

// Fetch data
const result = await getBlogPageData(id, locale);

// Handle 404
if (result.pageNotFound) {
  Astro.response.status = 404;
}

const heroImage = result.blogDetail?.images?.[0];
---

<BaseLayout {locale}>
  <div class="px-5">
    <div class="w-full flex flex-col justify-center items-center py-18 md:py-30">
      <ContentBlock
        title={result.blogDetail?.title ?? ''}
        description={result.blogDetail?.description ?? ''}
        align="center"
        colorScheme="dark"
        className="max-w-3xl"
      />
    </div>

    <StrapiImage
      image={heroImage}
      priority
      sizes="100vw"
      srcSetWidths={[640, 960, 1280, 1600]}
      className="object-cover h-highlight-mobile md:h-highlight-xl lg:h-highlight-3xl w-full"
    />

    <BlogDetailGallery
      title={result.blogDetail?.title}
      description={result.blogDetail?.description}
      images={result.blogDetail?.images}
    />

    <Blog
      {locale}
      {...homePage.blog}
      ctaHref={buildRoute(ROUTER.BLOGS, locale)}
      blogs={result.blogs}
      className="py-11 md:py-20"
    />
  </div>
</BaseLayout>
