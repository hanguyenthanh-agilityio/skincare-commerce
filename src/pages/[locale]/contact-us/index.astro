---
// Layouts
import { BaseLayout } from '@/layouts';

// I18n
import { loadContent } from '@/i18n';

// Sections
import { ContactUs } from '@/sections';

// Types
import type { ContactContent } from '@/types';

// Constants
import { isLocale, ROUTER } from '@/constants';

const { locale } = Astro.params;

if (!locale || !isLocale(locale)) {
  return Astro.redirect(ROUTER.NOT_FOUND);
}

const data = loadContent<ContactContent>('contact', locale);
---

<BaseLayout {locale}>
  <ContactUs data={data} />
</BaseLayout>
