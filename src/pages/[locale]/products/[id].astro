---
export const prerender = false;

// Layouts
import { BaseLayout } from '@/layouts';

// Sections
import { Blog, ProductDetail, RoutineList, Reviews, Benefits } from '@/sections';

// I18n
import { buildRoute, loadContent } from '@/i18n';

// Services
import { getBlogs, getProductPageData } from '@/services';

// Types
import type { HomeContent, ProductDetailContent, Attribute } from '@/types';

// Utils
import { richTextToPlainText, getRatingBreakdown, richTextToMutable } from '@/utils';

// Constants
import { isLocale, ROUTER } from '@/constants';

const { id, locale } = Astro.params;

if (!id || !locale || !isLocale(locale)) {
  return Astro.redirect(ROUTER.NOT_FOUND);
}

const { productDetail: product } = await getProductPageData(id, locale);

if (!product) {
  return Astro.redirect(ROUTER.NOT_FOUND);
}

// Load static content
const homePage = loadContent<HomeContent>('home', locale);
const productContent = loadContent<ProductDetailContent>('products-slug', locale);

const { blog } = homePage;
const { attributeLabels, review: reviewContent, routine, labels, image } = productContent;

// Fetch blogs
const { blogs } = await getBlogs({ locale });

// Prepare Product Attributes
const attributes: Attribute[] = [
  product.skinFeel && attributeLabels.skinFeel
    ? { label: attributeLabels.skinFeel, value: product.skinFeel }
    : null,
  product.ingredients && attributeLabels.ingredients
    ? {
        label: attributeLabels.ingredients,
        value: richTextToPlainText(product.ingredients),
      }
    : null,
].filter(Boolean) as Attribute[];

// Reviews
const reviews = product.reviews ?? [];
const hasReviews = reviews.length > 0;

const reviewAverage = product.averageRating ?? 0;
const totalReviewsCount = reviews.length;
const ratingBreakdown = getRatingBreakdown(reviews);

// Convert readonly API RichTextBlock to mutable for Benefits
const benefitsData = {
  ingredients: richTextToMutable(product?.ingredients),
  benefits: richTextToMutable(product?.benefits),
  usages: richTextToMutable(product?.usages),
};
---

<BaseLayout {locale}>
  <ProductDetail {locale} product={product} attributes={attributes} />

  <RoutineList steps={routine.steps} title={routine.title} subTitle={routine.subTitle} />

  <Benefits labels={labels} data={benefitsData} image={image} />

  {
    hasReviews && (
      <Reviews
        labels={reviewContent}
        average={reviewAverage}
        totalReviews={totalReviewsCount}
        reviews={reviews}
        breakdown={ratingBreakdown}
      />
    )
  }
  <Blog
    {locale}
    {...blog}
    blogs={blogs}
    ctaHref={buildRoute(ROUTER.BLOGS, locale)}
    className="mx-5 md:mx-8 py-11 md:py-24"
  />
</BaseLayout>
