---
// Layouts
import { BaseLayout, ProductLayout } from '@/layouts';

// Sections
import { Blog, Highlight, ProductToolbar } from '@/sections';

// I18n
import { buildRoute, loadContent } from '@/i18n';

// Types
import type { ProductContent } from '@/types';

// Constants
import { isLocale, ROUTER } from '@/constants';

// Utils
import { getFilterParams } from '@/utils';

// Services
import { getBlogs, getProducts } from '@/services';

const { locale } = Astro.params;

if (!locale || !isLocale(locale)) {
  return Astro.redirect(ROUTER.NOT_FOUND);
}

const url = Astro.url;

const productPage = loadContent<ProductContent>('products', locale);

const {
  highlight,
  sort: sortContent,
  categoryFilter,
  skinTypeFilter,
  priceRange,
  product,
  blog,
} = productPage;

const filters = getFilterParams(url);

const { page, sort, category, skinType, minPrice, maxPrice } = filters;

// Get list products
const { products, pagination } = await getProducts({
  page,
  pageSize: 2,
  locale,
  sort,
  filters: { category, skinType, minPrice, maxPrice },
});

// Get list blogs
const { blogs } = await getBlogs({ locale });
---

<BaseLayout {locale}>
  <Highlight data={highlight} />

  <ProductToolbar
    categoryValue={category}
    skinTypeValue={skinType}
    sortValue={sort}
    category={categoryFilter}
    skinType={skinTypeFilter}
    {priceRange}
    sort={sortContent}
    {locale}
  />

  <ProductLayout
    {locale}
    {products}
    {product}
    page={pagination.page}
    pageCount={pagination.pageCount}
  />

  <Blog
    {locale}
    {...blog}
    ctaHref={buildRoute(ROUTER.BLOGS, locale)}
    blogs={blogs}
    className="mx-5 md:mx-8 py-11 md:py-24"
  />
</BaseLayout>
