---
// Layouts
import { BaseLayout } from '@/layouts';

// I18n
import { loadContent } from '@/i18n';

// Types
import type { CheckoutContent } from '@/types';

// Section
import { CheckoutForm, OrderSummary } from '@/sections';

// Constants
import { isLocale, ROUTER } from '@/constants';

// Services
import { getCartByUser } from '@/services';

const { locale } = Astro.params;

if (!locale || !isLocale(locale)) {
  return Astro.redirect(ROUTER.NOT_FOUND);
}

const checkout = loadContent<CheckoutContent>('checkout', locale);

const USER_DOCUMENT_ID = import.meta.env.PUBLIC_STRAPI_USER_DOCUMENT_ID;

const cartItems = await getCartByUser({
  userDocumentId: USER_DOCUMENT_ID,
});
---

<BaseLayout {locale}>
  <div class="mx-auto grid md:grid-cols-2 gap-10">
    <CheckoutForm t={checkout} />
    <OrderSummary items={cartItems} t={checkout} />
  </div>
</BaseLayout>
