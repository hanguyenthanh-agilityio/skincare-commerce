---
// Layouts
import { BaseLayout } from '@/layouts';

// Sections
import { UserVoice, Highlight, Feature, Quote, FaqInfo } from '@/sections';

// I18n
import { loadContent } from '@/i18n';

// Types
import type { HomeContent } from '@/types';

import { Carousel, Product, Blog } from '@/sections';

// Constants
import { LOCALES } from '@/constants';

// Services
import { getBlogs, getProducts } from '@/services';
import { CreditCard, Leaf, Monitor, ShoppingBag, Truck } from 'lucide-react';

const locale = LOCALES.EN;

const homePage = loadContent<HomeContent>('home', locale);

const { carousel, feature, highlight, quote, product, blog } = homePage;

const { blogs } = await getBlogs({ locale });

const { products } = await getProducts({ locale });

const topics = [
  { id: 'products', label: 'Products and services', icon: ShoppingBag },
  { id: 'orders', label: 'Orders and shipping', icon: Truck },
  { id: 'payment', label: 'Payment and My Account', icon: CreditCard },
  { id: 'website', label: 'Website assistance', icon: Monitor },
  { id: 'sustainability', label: 'Sustainability', icon: Leaf },
];

const sections = [
  {
    id: 'services',
    title: 'Services',
    items: [
      { id: '1', label: 'How can I obtain personalised product advice?' },
      { id: '2', label: 'Does Aesop offer Facial Treatments?' },
    ],
  },
  {
    id: 'general',
    title: 'General product information',
    items: [],
  },
  {
    id: 'ingredients',
    title: 'Product ingredients',
    items: [],
  },
];
---

<BaseLayout {locale}>
  <FaqInfo
    topics={topics}
    sections={sections}
    title="Cannot find what you are looking for? We warmly invite you to contact us."
  />
  <Carousel slides={carousel} />

  <Feature
    data={feature}
    imageWrapperClass="h-highlight-mobile lg:h-highlight-lg xl:h-highlight-xl"
  />

  <Product
    {...product}
    products={products}
    limitMobile={2}
    limitDesktop={4}
    className="mx-5 md:mx-8"
  />

  <Highlight data={highlight} />

  <Quote
    title={quote.title}
    description={quote.description}
    className="py-15 px-5 md:px-15"
    sectionClassName="h-highlight-md md:h-highlight-lg"
  />
  <UserVoice />

  <Blog {...blog} blogs={blogs} className="mx-5 md:mx-8" />
</BaseLayout>
