---
// Layouts
import { BaseLayout } from '@/layouts';

// Sections
import { UserVoice, Highlight, Feature, Quote } from '@/sections';

// I18n
import { loadContent } from '@/i18n';

// Types
import type { HomeContent } from '@/types';

import { Carousel, Product, Blog } from '@/sections';

// Constants
import { LOCALES } from '@/constants';

// Mocks
import { MOCKS_BLOGS, MOCKS_PRODUCTS } from '@/mocks';

const locale = LOCALES.EN;

const page = loadContent<HomeContent>('home', locale);

const { carousel, feature, highlight, quote, product, blog } = page;
---

<BaseLayout {locale}>
  <Carousel slides={carousel} client:load />

  <Feature
    data={feature}
    imageWrapperClass=" h-highlight-mobile lg:h-highlight-lg xl:h-highlight-xl"
  />

  <Highlight data={highlight} />

  <Product {...product} products={MOCKS_PRODUCTS} className="mx-5 md:mx-8" />

  <Quote
    title={quote.title}
    description={quote.description}
    className="py-15 px-5 md:px-15"
    sectionClassName="h-highlight-md md:h-highlight-lg"
  />

  <UserVoice />

  <Blog {...blog} blogs={MOCKS_BLOGS} className="mx-5 md:mx-8" />
</BaseLayout>
