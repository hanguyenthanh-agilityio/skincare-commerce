---
// Layouts
import { BaseLayout } from '@/layouts';

// Components
import { BlogList, ProductList } from '@/components';

// Sections
import { UserVoice, Highlight, Feature } from '@/sections';

// I18n
import { loadPageContent } from '@/i18n';

// Types
import type { HomeContent } from '@/types';

import { Carousel } from '@/sections';

const locale = 'en';
const page = loadPageContent<HomeContent>('home', locale);
---

<BaseLayout>
  <Carousel slides={page.carousel} client:load />
  <Highlight data={page.highlight} />
  <Feature
    data={page.feature}
    imageWrapperClass=" h-highlight-mobile lg:h-highlight-lg xl:h-highlight-xl"
  />
  <UserVoice />

  <ProductList products={[]} limitDesktop={8} limitMobile={4} />

  <BlogList blogs={[]} />
</BaseLayout>
