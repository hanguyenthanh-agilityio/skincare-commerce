---
export const prerender = false;

// Layouts
import { BaseLayout } from '@/layouts';

// Components
import { Heading, Link, Typography } from '@/components';

// UIs
import { Button, Icons } from '@/ui';

// I18n
import { loadContent } from '@/i18n';

// Types
import type { ProductContextContent } from '@/types';

// Constants
import { LOCALES } from '@/constants';

const { category } = Astro.params;
const locale = LOCALES.EN;

const content = loadContent<ProductContextContent>('products-category', locale);

const title = (category ?? '').replace('-', ' ');
---

<BaseLayout {locale}>
  <section class="min-h-[50vh] flex flex-col items-center justify-center text-center px-4">
    <Heading
      level="h2"
      className="text-3xl md:text-4xl font-semibold capitalize mb-4"
      title={`${title} ${content.titleSuffix}`}
    />

    <Typography
      level="p"
      className="text-sm text-muted-foreground mb-8 max-w-md"
      title={content.description}
    />

    <Link href="/products">
      <Button variant="secondary" className="px-6 py-2 text-sm">
        <Icons.back className="size-4" />{content.backText}
      </Button>
    </Link>
  </section>
</BaseLayout>
