---
export const prerender = false;

// Layouts
import { BaseLayout } from '@/layouts';

// Constants
import { LOCALES } from '@/constants';

// Sections
import { Blog, ProductDetail, RoutineList, NotFound, Reviews } from '@/sections';

// I18n
import { loadContent } from '@/i18n';

// Services
import { getProductPageData, getBlogs } from '@/services';

// Types
import type {
  HomeContent,
  ProductDetailContent,
  NotFoundContent,
  Attribute,
  BlogContent,
} from '@/types';

// Utils
import { richTextToPlainText, getRatingBreakdown } from '@/utils';

const locale = LOCALES.EN;
const { id } = Astro.params;

// Load static content
const homePage = loadContent<HomeContent>('home', locale);
const blogList = loadContent<BlogContent>('blog', locale);
const productDetailPage = loadContent<ProductDetailContent>('products-slug', locale);
const notFoundContent = loadContent<NotFoundContent>('404', locale);

const { blog } = homePage;
const { routine, review } = productDetailPage;

// Fetch product data
const result = await getProductPageData(id, locale);

if (result.pageNotFound) {
  Astro.response.status = 404;
}

// Fetch blogs
const { blogs } = await getBlogs({ locale });

const product = result.productDetail;

// Attribute - Product Detail data
const attributes: Attribute[] = product
  ? [
      ...(product.skinFeel ? [{ label: 'Skin feel', value: product.skinFeel }] : []),

      ...(product.ingredients
        ? [{ label: 'Ingredients', value: richTextToPlainText(product.ingredients) }]
        : []),
    ]
  : [];

// Reviews data
const reviews = product?.reviews ?? [];

const reviewAverage = product?.averageRating ?? 0;
const totalReviews = reviews.length;
const breakdown = getRatingBreakdown(reviews);
---

<BaseLayout {locale}>
  {
    result.pageNotFound || !result.productDetail ? (
      <NotFound {...notFoundContent} />
    ) : (
      <>
        <ProductDetail product={result.productDetail} attributes={attributes} />

        <RoutineList steps={routine.steps} title={routine.title} subTitle={routine.subTitle} />

        {reviews.length > 0 && (
          <Reviews
            labels={review}
            average={reviewAverage}
            totalReviews={totalReviews}
            reviews={reviews}
            breakdown={breakdown}
          />
        )}

        <Blog
          {...blog}
          blogs={blogs}
          ctaLabel={blogList.ctaLabel}
          className="mx-5 md:mx-8 py-11 md:py-24"
        />
      </>
    )
  }
</BaseLayout>
