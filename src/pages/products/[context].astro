---
export const prerender = false;

// Layouts
import { BaseLayout } from '@/layouts';

// I18n
import { loadContent } from '@/i18n';

// Types
import type { ProductContent } from '@/types';

// Constants
import { LOCALES } from '@/constants';

import { MOCK_PRODUCTS } from '@/mocks';

// Section
import { Product } from '@/sections';

const locale = LOCALES.EN;

const productPage = loadContent<ProductContent>('products', locale);

const { product } = productPage;
---

<BaseLayout {locale}>
  <!-- ℹ️ NOTE:
  Just for test UI - will remove with integration API task -->
  <Product {...product} products={MOCK_PRODUCTS} className="mx-5 md:mx-8" />
</BaseLayout>
