---
export const prerender = false;

// Layouts
import { BaseLayout } from '@/layouts';

// Sections
import { Benefits, RoutineList, ProductDetail } from '@/sections';

// Constants
import { LOCALES } from '@/constants';

/**
 * ℹ️ NOTE:
 * Just for test UI - will remove with integration API task
 */
import { ATTRIBUTES, MOCK_PRODUCTS, PRODUCT_DETAIL, PRODUCT_INFO } from '@/mocks';

// Libs
import { buildProductBreadcrumb, getProductContext } from '@/lib';

// I18n
import { loadContent } from '@/i18n';

// Types
import type { ProductDetailContent } from '@/types';

const locale = LOCALES.EN;
const { slug } = Astro.params;

const product = MOCK_PRODUCTS.find((p) => p.slug === slug);

const context = getProductContext(product);
const breadcrumb = buildProductBreadcrumb(context);

const content = loadContent<ProductDetailContent>('products-slug', locale);

const { routine, labels, image } = content;
---

<BaseLayout {locale}>
  <ProductDetail product={PRODUCT_INFO} attributes={ATTRIBUTES} breadcrumbItems={breadcrumb} />
  <RoutineList steps={routine.steps} title={routine.title} subTitle={routine.subTitle} />
  <Benefits labels={labels} data={PRODUCT_DETAIL} image={image} />
</BaseLayout>
