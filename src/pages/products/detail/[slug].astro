---
export const prerender = false;

import { BaseLayout } from '@/layouts';
import { Heading, Typography } from '@/components';
import { LOCALES } from '@/constants';
import { MOCK_PRODUCTS } from '../index.astro';
import { buildProductBreadcrumb } from '@/lib/buildBreadcrumb';
import ProductBreadcrumb from '@/components/ProductBreadcrumb';
import { getProductContext } from '@/lib/productContext';

const locale = LOCALES.EN;
const { slug } = Astro.params;

const product = MOCK_PRODUCTS.find((p) => p.slug === slug);

const context = getProductContext(product);
const breadcrumb = buildProductBreadcrumb(context);
---

<BaseLayout {locale}>
  <section class="px-6 py-8 max-w-7xl mx-auto">
    <ProductBreadcrumb items={breadcrumb} />

    <Heading
      level="h2"
      className="mt-6 text-3xl font-semibold"
      title={product?.name ?? 'Product'}
    />

    <Typography
      level="p"
      className="mt-2 text-muted-foreground"
      title={`Volume: ${product?.volume}`}
    />
  </section>
</BaseLayout>
