---
export const prerender = false;

// Layouts
import { BaseLayout } from '@/layouts';

// Constants
import { LOCALES } from '@/constants';

// Components
import { ContentBlock, StrapiImage } from '@/components';

// Sections
import { Blog, BlogDetailGallery } from '@/sections';

// I18n
import { loadContent } from '@/i18n';

// Services
import { getBlogs } from '@/services';

// Types
import type { HomeContent } from '@/types';

// Mocks
import { BLOG_DETAIL_CONTENT, BLOG_HERO_IMAGE, BLOG_IMAGE } from '@/mocks';

const locale = LOCALES.EN;

const { documentId } = Astro.params;

if (!documentId) {
  throw new Error('Missing product documentId');
}

const homePage = loadContent<HomeContent>('home', locale);

const { blog } = homePage;

const { blogs } = await getBlogs({ locale });
---

<BaseLayout {locale}>
  <div class="px-5">
    <div class="w-full flex flex-col justify-center items-center py-18 md:py-30">
      <ContentBlock
        title={BLOG_DETAIL_CONTENT.hero.title}
        description={BLOG_DETAIL_CONTENT.hero.description}
        align="center"
        colorScheme="dark"
        className="max-w-3xl"
      />
    </div>

    <StrapiImage
      image={BLOG_HERO_IMAGE}
      className="object-cover h-highlight-mobile md:h-highlight-xl lg:h-highlight-3xl w-full"
    />

    <div class="w-full flex flex-col justify-center items-center py-18 md:py-30">
      <ContentBlock
        title={BLOG_DETAIL_CONTENT.section.title}
        description={BLOG_DETAIL_CONTENT.section.description}
        align="left"
        colorScheme="dark"
        className="max-w-4xl"
      />
    </div>

    <BlogDetailGallery images={BLOG_IMAGE} />

    <Blog {...blog} blogs={blogs} />
  </div>
</BaseLayout>
