---
// Components
import { EmblaCarousel } from '@/components';

// Types
import type { Slide } from '@/types';

interface Props {
  slides: Slide[];
}

const { slides } = Astro.props;
---

<div class="relative w-full overflow-hidden">
  <!-- React carousel -->
  <EmblaCarousel client:load slides={slides} />
</div>
