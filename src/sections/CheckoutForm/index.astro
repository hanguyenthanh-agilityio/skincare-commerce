---
// Types
import type { CheckoutContent } from '@/types';

// Components
import { Button, Input } from '@/ui';

import { Heading, Image } from '@/components';

// Payment methods
import paypal from '@/assets/payment/paypal.png';
import amex from '@/assets/payment/amex.png';
import visa from '@/assets/payment/visa.png';
import mastercard from '@/assets/payment/mastercard.png';

// Props
const { content } = Astro.props as {
  content: CheckoutContent;
};

const PAYMENT_METHODS = [
  { key: 'paypal', src: paypal },
  { key: 'amex', src: amex },
  { key: 'visa', src: visa },
  { key: 'mastercard', src: mastercard },
] as const;

const { title, paymentMethods, form: formContent } = content;

const {
  namePlaceholder,
  nameLabel,
  cardNumberPlaceholder,
  cardNumberLabel,
  expDatePlaceholder,
  expDateLabel,
  cvcPlaceholder,
  cvcLabel,
  confirmButton,
} = formContent;
---

<section aria-labelledby="checkout-heading" class="max-w-md w-full mx-auto p-6 space-y-6">
  <Heading level="h2" className="font-semibold" title={title} />

  <!-- Payment Methods -->
  <div class="flex space-x-2">
    {
      PAYMENT_METHODS.map(({ src, key }) => (
        <Button
          variant="ghost"
          type="button"
          className="flex items-center justify-center border rounded hover:shadow-md transition h-auto px-1 md:px-5"
          aria-label={paymentMethods[key]}
          key={key}
        >
          <Image src={src} alt={paymentMethods[key]} class="h-12 w-12 md:h-20 md:w-20" />
        </Button>
      ))
    }
  </div>

  <!-- Card Form -->
  <div class="space-y-6">
    <Input id="name" placeholder={namePlaceholder} label={nameLabel} />
    <Input id="cardNumber" placeholder={cardNumberPlaceholder} label={cardNumberLabel} />

    <div class="flex space-x-4">
      <Input id="expDate" placeholder={expDatePlaceholder} label={expDateLabel} />
      <Input id="cvc" placeholder={cvcPlaceholder} label={cvcLabel} />
    </div>
  </div>

  <Button className="w-full mt-4" variant="default">
    {confirmButton}
  </Button>
</section>
