---
import { Heading, StrapiImage, Typography } from '@/components';

import type { CartItem } from '@/types';

import { getCartTotal } from '@/utils';

export const MOCK_CHECKOUT_ITEMS: CartItem[] = [
  {
    id: '1',
    name: 'Hydrating Face Cream',
    price: 29.99,
    quantity: 2,
    image: {
      url: 'https://www.gloskinbeauty.com/cdn/shop/articles/668448456942_0f2549ad-4f14-4e19-81c6-23fa6fca465d.jpg?v=1760637019',
      alternativeText: 'Hydrating Face Cream',
      width: 500,
      height: 500,
    },
  },
  {
    id: '2',
    name: 'Gentle Cleansing Foam',
    price: 19.99,
    quantity: 1,
    image: {
      url: 'https://www.gloskinbeauty.com/cdn/shop/articles/668448456942_0f2549ad-4f14-4e19-81c6-23fa6fca465d.jpg?v=1760637019',
      alternativeText: 'Hydrating Face Cream',
      width: 500,
      height: 500,
    },
  },
];

const items: CartItem[] = MOCK_CHECKOUT_ITEMS;
const subtotal = getCartTotal(items);
const tax = 5;
const total = subtotal + tax;
---

<section class="max-w-md w-full mx-auto p-6 bg-blue-50 space-y-6">
  <Heading level="h2" className="font-semibold" title="Order Summary" />

  <div class="divide-y divide-gray-200 m-0">
    {
      items.map((item) => (
        <div class="flex space-x-4 items-center py-4">
          <StrapiImage image={item.image} className="w-16 h-16 rounded object-cover" />
          <div class="flex-1">
            <Typography level="p" className="font-medium" title={item.name} />
            <Typography level="p" className="font-semibold" title={`$${item.price.toFixed(2)}`} />
          </div>
        </div>
      ))
    }
  </div>

  <div class="border-t divide-y divide-gray-200">
    {
      [
        { label: 'Subtotal', value: subtotal.toFixed(2) },
        { label: 'Coupon Discount', value: '0%' },
        { label: 'TAX', value: tax.toFixed(2) },
      ].map((item) => (
        <div class="flex justify-between py-3">
          <Typography level="span" title={item.label} />
          <Typography level="span" title={item.value} />
        </div>
      ))
    }

    <div class="flex justify-between font-bold text-lg py-3">
      <Typography level="span" title="Total" />
      <Typography level="span" title={`$${total.toFixed(2)}`} />
    </div>
  </div>
</section>
