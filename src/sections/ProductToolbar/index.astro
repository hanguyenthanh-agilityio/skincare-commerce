---
// Types
import type { CategoryValue, Locale, ProductContent, SkinTypeValue, SortValue } from '@/types';

// Components
import { PriceRange, SortDropdown, CategoryFilter, SkinTypeFilter } from '@/components';

interface Props {
  category: ProductContent['categoryFilter'];
  skinType: ProductContent['skinTypeFilter'];
  sort: ProductContent['sort'];
  priceRange: ProductContent['priceRange'];
  sortValue: SortValue;
  categoryValue: CategoryValue;
  skinTypeValue: SkinTypeValue;
  locale: Locale;
}

const { category, skinType, sort, priceRange, sortValue, categoryValue, skinTypeValue, locale } =
  Astro.props;
---

<section aria-label="Product filters and sorting" class="bg-narvik border-b border-black/5 mb-10">
  <div class="mx-auto px-4 py-5 space-y-5">
    <!-- ROW 1 -->
    <div
      class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between border-b border-quill-grey"
    >
      <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:gap-6">
        <CategoryFilter {locale} value={categoryValue} content={category} client:load />

        <SkinTypeFilter {locale} value={skinTypeValue} content={skinType} client:load />

        <SortDropdown {locale} value={sortValue} content={sort} client:load />
      </div>
    </div>

    <!-- ROW 2: Price -->
    <PriceRange
      client:load
      title={priceRange.title}
      labels={priceRange}
      min={0}
      max={2000}
      className="w-full sm:max-w-sm md:max-w-xs"
    />
  </div>
</section>
