---
// Types
import type { CategoryValue, ProductContent, SkinTypeValue, SortValue } from '@/types';

// Components
import { PriceRange, SortDropdown, CategoryFilter, SkinTypeFilter } from '@/components';

interface Props {
  category: ProductContent['categoryFilter'];
  skinType: ProductContent['skinTypeFilter'];
  sort: ProductContent['sort'];
  priceRange: ProductContent['priceRange'];
  valueSort: SortValue;
  valueCategory: CategoryValue;
  valueSkinType: SkinTypeValue;
}

const { category, skinType, sort, priceRange, valueSort, valueCategory, valueSkinType } =
  Astro.props;
---

<section aria-label="Product filters and sorting" class="bg-narvik border-b border-black/5 mb-10">
  <div class="mx-auto px-4 py-5 space-y-5">
    <!-- ROW 1 -->
    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
      <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:gap-6">
        <CategoryFilter value={valueCategory} content={category} client:load />

        <SkinTypeFilter value={valueSkinType} content={skinType} client:load />

        <SortDropdown value={valueSort} content={sort} client:load />
      </div>
    </div>

    <!-- Divider -->
    <div class="h-px bg-black/5"></div>

    <!-- ROW 2: Price -->
    <PriceRange
      client:load
      title={priceRange.title}
      labels={priceRange}
      min={0}
      max={2000}
      className="w-full sm:max-w-sm md:max-w-xs"
    />
  </div>
</section>
