---
import { DropdownMenu, PriceRange, SortDropdown } from '@/components';
import type { ProductContent } from '@/types';

interface Props {
  filterMenu: ProductContent['filterMenu'];
  sort: ProductContent['sort'];
  priceRange: ProductContent['priceRange'];
}

const { filterMenu, sort, priceRange } = Astro.props;
---

<section aria-label="Product filters and sorting" class="bg-narvik border-b border-black/5">
  <div class="mx-auto px-4 py-5 space-y-5">
    <!-- ROW 1 -->
    <div class="flex flex-col gap-4
        sm:flex-row sm:items-center sm:justify-between">
      <!-- Left: Dropdowns -->
      <div class="flex flex-col gap-3
          sm:flex-row sm:items-center sm:gap-6">
        <DropdownMenu client:load data={filterMenu} className="flex gap-6" />
      </div>

      <!-- Right: Sort -->
      <div class="self-start sm:self-auto">
        <SortDropdown client:load content={sort} />
      </div>
    </div>

    <!-- Divider -->
    <div class="h-px bg-black/5"></div>

    <!-- ROW 2: Price -->
    <div>
      <PriceRange
        client:load
        title={priceRange.title}
        labels={priceRange}
        min={0}
        max={1000}
        className="w-full sm:max-w-sm md:max-w-xs"
      />
    </div>
  </div>
</section>
