---
import { ContentBlock, HeroImage } from '@/components';
---

<section class="grid md:grid-cols-2 gap-6 items-center">
  <ContentBlock
    subTitle="Revitalize Your Body"
    title="Effective Ingredients for Visible Results"
    description="Our body products are rich in highly effective ingredients, achieve visible results, firm the skin and leave it feeling soft and supple."
    buttonText="Discover More"
    colorScheme="light"
    variant="outlineWhite"
  />

  <HeroImage
    image="https://img.freepik.com/free-photo/horizontal-banner-beauty-products_23-2149446551.jpg?semt=ais_hybrid&w=740&q=80"
    className="rounded-xl"
    client:load
  />
</section>
