---
// Types
import type { TBlog } from '@/types';

// Components
import { BlogList } from '@/components';
import { SectionWrapper } from '@/layouts';

interface Props {
  title: string;
  subtitle: string;
  description?: string;
  ctaLabel: string;
  ctaHref?: string;
  blogs: TBlog[];
  className?: string;
}

const { title, subtitle, description, ctaHref, ctaLabel, blogs, className } = Astro.props;
---

<SectionWrapper {title} {subtitle} {description} {ctaHref} {ctaLabel} {className}>
  <BlogList blogs={blogs} ctaLabel={ctaLabel} />
</SectionWrapper>
