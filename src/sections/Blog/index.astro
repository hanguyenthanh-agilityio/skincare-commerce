---
// Types
import type { Locale, TBlog } from '@/types';

// Components
import { BlogList } from '@/components';
import { SectionWrapper } from '@/layouts';

interface Props {
  title: string;
  subtitle: string;
  description?: string;
  ctaLabel?: string;
  ctaHref?: string;
  blogs: TBlog[];
  locale: Locale;
  className?: string;
}

const { title, subtitle, description, ctaHref, ctaLabel, blogs, locale, className } = Astro.props;
---

<SectionWrapper {title} {subtitle} {description} {ctaHref} {ctaLabel} {className}>
  <BlogList {locale} {blogs} />
</SectionWrapper>
