---
// Components
import { ContentBlock, StrapiImage } from '@/components';

// Libs
import { cn } from '@/lib';

// Types
import type { HomeContent } from '@/types';

interface Props {
  data: HomeContent['highlight'];
  reverse?: boolean;
  className?: string;
  imageWrapperClass?: string;
}

const { data, reverse, className, imageWrapperClass } = Astro.props;

const { subTitle, title, description, buttonText, buttonHref, align, colorScheme, variant, image } =
  data;
---

<section class={cn('w-full py-8 lg:py-20 px-6 md:px-12', className)}>
  <div class="grid grid-cols-1 md:grid-cols-2 items-center gap-10">
    <!-- Image -->
    <div
      class={cn(
        'relative w-full overflow-hidden',
        reverse ? 'order-2 md:order-1' : 'order-1 md:order-2',
        imageWrapperClass,
      )}
    >
      <StrapiImage image={image} className="w-full h-full object-cover" fallbackAspectRatio={0} />
    </div>

    <!-- Content -->
    <ContentBlock
      title={title}
      subTitle={subTitle}
      description={description}
      buttonText={buttonText}
      buttonHref={buttonHref}
      colorScheme={colorScheme}
      variant={variant}
      align={align}
      className={cn(reverse ? 'order-2' : 'order-1 md:order-1', 'lg:px-8')}
    />
  </div>
</section>
