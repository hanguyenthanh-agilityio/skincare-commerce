---
// Components
import { ContentBlock, StrapiImage } from '@/components';

// Libs
import { cn } from '@/lib';

// Types
import type { HomeContent } from '@/types';

interface Props {
  data: HomeContent['highlight'];
  reverse?: boolean;
  className?: string;
  imageWrapperClass?: string;
}

const { data, reverse, className, imageWrapperClass } = Astro.props;

const { subTitle, title, description, buttonText, buttonHref, align, colorScheme, variant, image } =
  data;
---

<section class={cn('w-full py-12 md:py-20 px-6 md:px-12', className)}>
  <div
    class={`grid grid-cols-1 md:grid-cols-2 items-center gap-10 ${
      reverse ? 'md:flex-row-reverse' : ''
    }`}
  >
    <!-- Image -->
    <div class={cn('relative w-full overflow-hidden', imageWrapperClass)}>
      <StrapiImage
        client:idle
        image={image}
        className="w-full h-full object-cover"
        fallbackAspectRatio={0}
      />
    </div>

    <!-- Content -->
    <ContentBlock
      title={title}
      subTitle={subTitle}
      description={description}
      buttonText={buttonText}
      buttonHref={buttonHref}
      colorScheme={colorScheme}
      variant={variant}
      align={align}
      className="lg:px-8"
    />
  </div>
</section>
