---
// Components
import { StrapiImage, ProductInfo } from '@/components';

// Types
import type { Attribute, BreadcrumbItem, TProduct } from '@/types';

interface Props {
  product: TProduct;
  attributes: Attribute[];
  breadcrumbItems: BreadcrumbItem[];
}

const { product, attributes, breadcrumbItems } = Astro.props as Props;

const mainImage = product.images?.[0];
---

<section class="mx-auto">
  <div class="grid grid-cols-1 gap-10 md:grid-cols-10">
    <!-- Image -->
    <div class="md:col-span-6">
      {
        mainImage && (
          <div class="relative overflow-hidden border bg-background min-h-highlight-lg md:min-h-hero-md lg:min-h-hero-lg xl:min-h-hero-xl">
            <StrapiImage
              image={mainImage}
              className="absolute inset-0 h-full w-full object-cover"
              sizes="(min-width: 1024px) 60vw, 100vw"
              priority
            />
          </div>
        )
      }
    </div>

    <!-- Content -->
    <div
      class="md:col-span-4 flex flex-col justify-center items-start py-12 md:py-10 px-5 md:pl-0 lg:pr-20"
    >
      <ProductInfo product={product} attributes={attributes} breadcrumbItems={breadcrumbItems} />
    </div>
  </div>
</section>
