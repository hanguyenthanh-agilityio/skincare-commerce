---
// Components
import { Heading, UserVoiceGrid } from '@/components';

// UIs
import { Icons, Button } from '@/ui';
---

<section class="py-12 md:py-24 bg-surface">
  <div class="container mx-auto px-6 lg:px-8">
    <!-- Title -->
    <Heading level="h2" title="User Voice" className="text-center font-normal" />

    <!-- Grid -->
    <UserVoiceGrid />

    <!-- More Button -->
    <div class="flex justify-center mt-10">
      <Button variant="outlineSoft" className="gap-30 py-7">
        More <Icons.Arrow />
      </Button>
    </div>
  </div>
</section>
