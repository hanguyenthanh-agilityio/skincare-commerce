---
// Types
import type { Labels, RatingBreakdown, Review } from '@/types';

// Components
import { ReviewCard, ReviewSummary } from '@/components';

interface Props {
  labels: Labels;
  average: number;
  totalReviews: number;
  reviews: Review[];
  breakdown: RatingBreakdown[];
}

const { labels, average, totalReviews, reviews, breakdown } = Astro.props;
---

<section class="flex flex-col xl:flex-row py-10 gap-10 xl:gap-40">
  <div class="xl:w-1/3">
    <ReviewSummary
      labels={labels}
      average={average}
      totalReviews={totalReviews}
      breakdown={breakdown}
    />
  </div>

  <div class="space-y-4 xl:w-2/3">
    {
      reviews.map(({ rating, date, comment, locale }) => (
        <ReviewCard rating={rating} date={date} comment={comment} locale={locale} />
      ))
    }
  </div>
</section>
