---
// Icons
import { TriangleAlert } from 'lucide-react';

// Components
import { Heading, Link, Typography } from '@/components';
import { Button } from '@/ui';

interface Props {
  title?: string;
  subtitle: string;
  ctaLabel?: string;
  ctaHref: string;
}

const { title = 'Page not found', subtitle, ctaLabel = 'Back to homepage', ctaHref } = Astro.props;
---

<section class="relative flex min-h-[60vh] flex-col items-center justify-center px-6 text-center">
  <!-- Icon wrapper -->
  <div
    class="mb-8 flex h-24 w-24 items-center justify-center rounded-full bg-red-50 text-red-500"
    aria-hidden="true"
  >
    <TriangleAlert className="h-14 w-14" />
  </div>

  <!-- Title -->
  <Heading
    level="h2"
    className="mb-4 text-3xl font-semibold tracking-tight md:text-5xl"
    title={title}
  />

  <!-- Subtitle -->
  <Typography
    level="p"
    className="mb-10 max-w-xl text-gray-600 dark:text-gray-400"
    title={subtitle}
  />

  <!-- Actions -->
  <Link href={ctaHref}>
    <Button className="rounded-lg px-6 py-3">{ctaLabel}</Button>
  </Link>
</section>
