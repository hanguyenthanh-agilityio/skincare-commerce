---
// Components
import { ContentBlock, StrapiImage } from '@/components';

const { title, description, images } = Astro.props;
---

<section class="w-full flex flex-col justify-center">
  <div class="w-full flex flex-col justify-center items-center py-18 md:py-30">
    <ContentBlock
      title={title}
      description={description}
      align="left"
      colorScheme="dark"
      className="max-w-4xl"
    />
  </div>
  <div class="grid grid-cols-1 md:grid-cols-[2fr_1fr] md:grid-rows-[1fr_1fr] gap-8 w-full">
    <!-- Main image -->
    <div class="row-span-2 overflow-hidden">
      <StrapiImage
        image={images.main}
        className="w-full h-highlight-mobile md:h-highlight-xl lg:h-highlight-2xl xl:h-highlight-3xl object-cover"
      />
    </div>

    <!-- Side image -->
    <div class="self-start overflow-hidden">
      <StrapiImage
        image={images.side}
        className="w-full h-highlight-mobile md:h-highlight-xs xl:h-highlight-lg object-cover"
      />
    </div>

    <!-- Empty cell -->
    <div aria-hidden="true"></div>
  </div>
</section>
