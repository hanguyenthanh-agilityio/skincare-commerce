---
// Components
import { CartSummary, Heading, Typography, CartTable } from '@/components';

// Types
import type { CartColumn, CartContent, CartItem } from '@/types';

// Utils
import { getCartTotal } from '@/utils';

interface Props {
  content: CartContent;
  items: CartItem[];
}

const { content, items } = Astro.props;
const total = getCartTotal(items);

const columns: CartColumn[] = [
  { key: 'product', title: content.columns.cart },
  { key: 'price', title: content.columns.price },
  { key: 'quantity', title: content.columns.quantity },
  { key: 'subtotal', title: content.columns.subtotal },
];
---

<section aria-labelledby="cart-heading" class="container-lg py-10 md:py-20 px-5">
  <!-- Header -->
  <header class="max-w-411 mb-12 mx-auto text-center">
    <Heading level="h2" className="mb-2" title={content.title} />
    <Typography level="p" title={content.description} />
  </header>

  <!-- Body -->
  <div class="flex flex-col">
    <CartTable columns={columns} items={items} />

    <div class="flex justify-end py-10">
      <CartSummary
        total={total.toString()}
        label={content.summary.totalLabel}
        shippingNote={content.summary.shippingNote}
        checkoutText={content.summary.checkout}
      />
    </div>
  </div>
</section>
