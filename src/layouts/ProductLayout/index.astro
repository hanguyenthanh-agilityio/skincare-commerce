---
// Types
import type { Locale, ProductContent, TProduct } from '@/types';

// Components
import { Product } from '@/sections';
import { PaginationControls } from '@/components';

interface Props {
  page: number;
  pageCount: number;
  products: TProduct[];
  product: ProductContent['product'];
  locale: Locale;
}

const { page, pageCount, products, product, locale } = Astro.props;
---

<>
  <Product {locale} {...product} {products} className="mx-5 md:mx-8" />

  <div class="flex justify-center pb-20">
    <PaginationControls client:load page={page} pageCount={pageCount} />
  </div>
</>
