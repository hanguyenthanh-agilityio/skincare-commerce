---
import { loadContent } from '@/i18n';
import { getProducts } from '@/services';

// Types
import type { Locale, ProductContent } from '@/types';

// Components
import { Highlight, Product, ProductToolbar } from '@/sections';
import { PaginationControls } from '@/components';

import type { SortValue } from '@/types';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const productPage = loadContent<ProductContent>('products', locale);

const { highlight, sort, filterMenu, priceRange } = productPage;

const { product } = productPage;

const url = new URL(Astro.request.url);

const sortValue = (url.searchParams.get('sort') as SortValue) ?? '';

const page = Math.max(1, Number(url.searchParams.get('page') ?? 1));

const category = url.searchParams.get('category') || '';
const skinType = url.searchParams.get('skinType') || '';
const minPrice = Number(url.searchParams.get('minPrice')) || 0;
const maxPrice = Number(url.searchParams.get('maxPrice')) || 1000;

const { products, pagination } = await getProducts({
  page,
  pageSize: 2,
  locale,
  sort: sortValue,
  filters: { category, skinType, minPrice, maxPrice },
});
---

<>
  <Highlight data={highlight} />

  <ProductToolbar
    valueSort={sortValue}
    filterMenu={filterMenu}
    priceRange={priceRange}
    sort={sort}
  />

  <Product {...product} {products} className="mx-5 md:mx-8" />

  <div class="flex justify-center">
    <PaginationControls client:load page={pagination.page} pageCount={pagination.pageCount} />
  </div>
</>
