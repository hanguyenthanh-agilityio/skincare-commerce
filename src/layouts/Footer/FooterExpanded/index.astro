---
// Constants
import { FOOTER_LINKS, NAVIGATION, ROUTER, SOCIAL_LINKS } from '@/constants';

// Components
import { MenuLinks, Heading, Link, Typography } from '@/components';
import { Icons } from '@/ui';
---

<div class="hidden md:block pt-18 pb-12 mx-10 space-y-38">
  <div class="flex justify-between gap-8">
    {/* Brand & Social */}
    <div class="w-full space-y-6">
      <h1>
        <Link href={ROUTER.HOME} aria-label="Home">
          <Icons.Logo color="white" />
        </Link>
      </h1>

      <Typography title="Follow us" level="span" className="block text-quill-grey uppercase" />

      <div class="flex gap-4">
        {
          SOCIAL_LINKS.map(({ href, label, icon: Icon }) => (
            <Link href={href} aria-label={label} className="transition-colors">
              <Icon />
            </Link>
          ))
        }
      </div>
    </div>

    {/* Navigation Columns */}
    <div class="w-full flex">
      {
        NAVIGATION.map(({ title, links }) => (
          <div class="min-w-56">
            <Heading level="h6" title={title} className="text-white font-bold mb-6" />

            <MenuLinks links={links} className="space-y-3.5" textClass="text-white text-sm/6" />
          </div>
        ))
      }
    </div>
  </div>

  {/* Divider */}
  <div class="flex gap-10">
    <Typography
      level="span"
      title="CEIN. 2019 KINS All rights reserved."
      className="block w-full text-xs text-quill-grey"
    />

    <MenuLinks links={FOOTER_LINKS} className="flex w-full gap-6" />
  </div>
</div>
