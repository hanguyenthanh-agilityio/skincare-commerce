---
// Constants
import { ROUTER } from '@/constants';

// Components
import { Link, MainNav, Navbar, LanguageSwitcher, Typography } from '@/components';

// UIs
import { Icons } from '@/ui';

// Types
import type { HeaderContent, Locale } from '@/types';

// I18N
import { loadContent } from '@/i18n';

interface Props {
  locale: Locale;
  pathname: string;
}

const { locale, pathname } = Astro.props;
const headerData = await loadContent<HeaderContent>('header', locale);

const navLinks: HeaderContent['navLinks'] = headerData.navLinks as HeaderContent['navLinks'];
const dropdownMenu: HeaderContent['dropdownMenu'] =
  headerData.dropdownMenu as HeaderContent['dropdownMenu'];
---

<header class="relative border-b border-black">
  <div class="mx-auto px-4 sm:px-6 lg:px-8 sm:py-2">
    <div class="flex items-center h-16">
      <div class="flex-1 flex justify-start items-center gap-2">
        <Navbar navLinks={navLinks} dropdownMenu={dropdownMenu} className="text-sm text-primary" />
        <div class="md:hidden">
          <LanguageSwitcher pathname={pathname} client:idle />
        </div>
      </div>

      <!-- Center: Logo -->
      <div class="flex-1 shrink-0 mx-auto">
        <h1 class="text-center">
          <Link href={ROUTER.HOME} className="inline-flex items-center">
            <Icons.Logo aria-hidden="true" />
            <Typography level="span" title="CEIN – Home" className="sr-only" />
          </Link>
        </h1>
      </div>

      <div class="flex-1 flex justify-end items-center gap-6">
        <div class="hidden md:flex">
          <LanguageSwitcher pathname={pathname} client:idle />
        </div>
        <MainNav />
      </div>
    </div>
  </div>
</header>
