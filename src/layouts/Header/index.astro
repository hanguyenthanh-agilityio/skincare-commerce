---
// Components
import { Link, Navbar } from '@/components';

// UIs
import { Icons } from '@/ui';
---

<header class="border-b border-black">
  <div class="mx-auto px-4 sm:px-6 lg:px-8 sm:py-2">
    <div class="flex items-center h-16">
      <div class="flex-1">
        <Navbar />
      </div>

      <!-- Center: Logo -->
      <div class="flex-shrink-0 mx-auto">
        <Link href="/">
          <img src="/logo.png" alt="CEIN Logo" class="h-5 w-auto" />
        </Link>
      </div>

      <!-- Right: Icons -->
      <div class="flex-1 flex justify-end items-center gap-6 text-gray-700">
        <Icons.User width={14} height={14} />
        <Icons.Lock width={14} height={14} />
      </div>
    </div>
  </div>
</header>
