---
// Constants
import { ROUTER } from '@/constants';

// Components
import { Link, MainNav, Navbar, LanguageSwitcher } from '@/components';

// UIs
import { Icons } from '@/ui';

interface Props {
  pathname: string;
}

const { pathname } = Astro.props;
---

<header class="border-b border-black" role="banner">
  <div class="mx-auto px-4 sm:px-6 lg:px-8 sm:py-2">
    <div class="flex items-center h-16">
      <div class="flex-1">
        <Navbar className="text-sm text-primary" />
      </div>

      <!-- Center: Logo -->
      <div class="flex-1 shrink-0 mx-auto">
        <h1>
          <Link href={ROUTER.HOME} aria-label="Home">
            <Icons.Logo />
          </Link>
        </h1>
      </div>

      <div class="flex-1 flex justify-end items-center space-x-1">
        <MainNav />
        <LanguageSwitcher pathname={pathname} client:idle />
      </div>
    </div>
  </div>
</header>
