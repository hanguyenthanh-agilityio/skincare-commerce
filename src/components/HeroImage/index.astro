---
import StrapiImage from '@/components/StrapiImage';
import type { StrapiImageType } from '@/types';

interface Props {
  src: string | StrapiImageType | null | undefined;
  className?: string;
}

const { src, className = '' } = Astro.props;
---

<div class={`relative w-full h-full overflow-hidden ${className}`}>
  <StrapiImage
    image={src}
    className="absolute inset-0 w-full h-full object-cover object-center"
    fallbackAspectRatio={0}
  />
</div>
