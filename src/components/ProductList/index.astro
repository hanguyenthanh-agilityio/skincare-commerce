---
import type { TProduct } from '@/types';

// Components
import { NormalBlock, ProductCard } from '@/components';

interface Props {
  products: TProduct[];
  limitDesktop: number;
  limitMobile: number;
}

const { products, limitDesktop, limitMobile } = Astro.props;

const displayMobile = products.slice(0, limitMobile);
const displayDesktop = products.slice(0, limitDesktop);
---

<div class="w-full">
  {
    products.length === 0 ? (
      <NormalBlock className="text-center w-full text-gray-500 text-xl">
        No Products Available
      </NormalBlock>
    ) : (
      <>
        {/* Mobile */}
        <div class="flex md:hidden flex-wrap gap-3.5">
          {displayMobile.map((product) => (
            <ProductCard {...product} />
          ))}
        </div>

        {/* Desktop */}
        <div class="hidden md:flex flex-wrap gap-4">
          {displayDesktop.map((product) => (
            <ProductCard {...product} />
          ))}
        </div>
      </>
    )
  }
</div>
