---
import { cn } from '@/lib';

// Types
import type { TProduct } from '@/types';

// Constants
import { ROUTER } from '@/constants';

// Components
import { ProductCard, Typography } from '@/components';

interface Props {
  products: TProduct[];
  limitDesktop?: number;
  limitMobile?: number;
}

const { products, limitDesktop, limitMobile } = Astro.props;

const productsData = Array.isArray(products) ? products : [];

const hasProducts = productsData.length > 0;

const hasLimit = typeof limitDesktop === 'number' || typeof limitMobile === 'number';
---

<div class="w-full my-8">
  {
    !hasProducts ? (
      <Typography
        level="p"
        title="No Products Available"
        className="text-center w-full text-gray-500"
      />
    ) : (
      <div class="flex flex-wrap gap-3.5 md:gap-1">
        {productsData.map((product, index) => {
          // If NO limits → show everything
          if (!hasLimit) {
            return (
              <ProductCard
                {...product}
                image={product.images?.[0]}
                href={`${ROUTER.PRODUCTS}/${product.documentId}`}
              />
            );
          }

          // Homepage responsive limits
          const visibleMobile = typeof limitMobile === 'number' ? index < limitMobile : true;

          const visibleDesktop = typeof limitDesktop === 'number' ? index < limitDesktop : true;

          const visibilityClass = cn(
            visibleMobile ? 'block' : 'hidden',
            visibleDesktop ? 'md:block' : 'md:hidden',
          );

          return (
            <div class={visibilityClass}>
              <ProductCard
                {...product}
                image={product.images?.[0]}
                href={`${ROUTER.PRODUCTS}/${product.documentId}`}
              />
            </div>
          );
        })}
      </div>
    )
  }
</div>
