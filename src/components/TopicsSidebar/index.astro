---
import type { Topic } from '@/types';
import { Heading, Typography } from '..';

interface Props {
  topics: Topic[];
}

const { topics } = Astro.props;
---

<aside>
  <Heading level="h2" className="mb-6 text-lg font-normal" title="Topics" />

  <ul class="space-y-4">
    {
      topics.map((topic) => (
        <li class="flex items-center gap-3 text-sm text-muted-foreground hover:text-foreground cursor-pointer">
          {topic.icon && <topic.icon className="size-4" />}
          <Typography level="span" title={topic.label} />
        </li>
      ))
    }
  </ul>
</aside>
