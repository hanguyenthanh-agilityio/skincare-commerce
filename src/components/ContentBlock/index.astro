---
// UIs
import { Button, Icons } from '@/ui';

// Components
import { Heading, Link, Typography } from '@/components';

// Utils
import { cn } from '@/lib/utils';

interface Props {
  title: string;
  subTitle?: string;
  description?: string;
  buttonText?: string;
  buttonHref?: string;
  align?: 'left' | 'center';
  colorScheme?: 'dark' | 'light';
  variant?: 'outlineSoft' | 'outlineWhite';
  class?: string;
}

const {
  subTitle,
  title,
  description,
  buttonText,
  buttonHref = '#',
  align = 'left',
  colorScheme = 'dark',
  variant = 'outlineSoft',
  class: className = '',
} = Astro.props;

// Alignment styles
const alignment = {
  left: 'text-left items-start',
  center: 'text-center items-center',
}[align];

// Color styling
const colorStyles = {
  dark: {
    subTitle: 'text-primary',
    title: 'text-primary',
    description: 'text-primary',
    icon: 'text-primary',
  },
  light: {
    subTitle: 'text-white',
    title: 'text-white',
    description: 'text-white',
    icon: 'text-white',
  },
};

const scheme = colorStyles[colorScheme] ?? colorStyles.dark;
---

<div class={cn('flex flex-col gap-4', alignment, className)}>
  {
    subTitle && (
      <Typography
        level="p"
        title={subTitle}
        className={cn('text-sm tracking-wide', scheme.subTitle)}
      />
    )
  }

  <Heading level="h2" title={title} className={cn('font-normal max-w-xl', scheme.title)} />

  {
    description && (
      <Typography level="p" title={description} className={cn('max-w-lg', scheme.description)} />
    )
  }

  {
    buttonText && (
      <Link href={buttonHref} className="inline-flex items-center gap-2 pt-2">
        <Button variant={variant} className="gap-30 py-7">
          {buttonText}
          <Icons.Arrow className={scheme.icon} />
        </Button>
      </Link>
    )
  }
</div>
