---
export interface Props {
  src: string;
  alt?: string;
  aspectRatio?: string;
  class?: string;
}

const { src, alt = '', aspectRatio, class: className } = Astro.props;

const style = aspectRatio ? `aspect-ratio:${aspectRatio};` : '';
---

<img src={src} alt={alt} class={className} style={style} loading="lazy" />
