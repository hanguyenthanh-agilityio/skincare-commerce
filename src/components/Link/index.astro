---
import { cn } from '@/lib';

interface Props {
  href: string;
  ariaLabel?: string;
  className?: string;
  target?: '_self' | '_blank' | '_parent' | '_top';
  rel?: string;
}

const { href, ariaLabel, className, target = '_self', rel } = Astro.props;
---

<a
  href={href}
  aria-label={ariaLabel}
  target={target}
  rel={rel}
  class={cn(`inline-flex items-center gap-2.5 text-destructive-foreground ${className}`)}
>
  <slot />
</a>
