---
import { cn } from '@/lib';

// Types
import type { UserActionsContent, Locale } from '@/types';

import { buildRoute, loadContent } from '@/i18n';

// Constants
import { ROUTER, SESSION_KEYS } from '@/constants';

// UIs
import { Button, Icons } from '@/ui';

// Components
import { Link } from '@/components';

interface Props {
  locale: Locale;
  className?: string;
}

const { locale, className } = Astro.props;

// 🔐 Detect auth
const token = await Astro.locals.session.get(SESSION_KEYS.JWT);
const isAuthenticated = Boolean(token);

const { login, logout, cart } = loadContent<UserActionsContent>('user-actions', locale);
---

<div class={cn('flex items-center gap-2 md:gap-5 text-gray-700', className)}>
  <!-- CART -->
  <Link
    href={buildRoute(ROUTER.CART, locale)}
    aria-label={cart.ariaLabel}
    className="inline-flex items-center justify-center w-8 h-8 rounded-md hover:bg-gray-100 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
    data-testid="cart-link"
  >
    <Icons.Cart data-testid="cart-icon" width={18} height={18} />
  </Link>

  <!-- AUTH AREA -->
  {
    isAuthenticated ? (
      <div class="relative group">
        <Button
          variant="ghost"
          size="icon"
          className="w-8 h-8"
          aria-haspopup="menu"
          aria-expanded="false"
          data-testid="user-menu-trigger"
        >
          <Icons.User data-testid="user-icon" width={18} height={18} />
        </Button>

        <div
          class="absolute z-50 right-0 mt-2 w-40 rounded-md border bg-white shadow-md opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-150"
          role="menu"
          data-testid="user-menu"
        >
          <form method="POST" action="/api/auth/logout">
            <Button
              variant="ghost"
              type="submit"
              className="w-full px-4 py-2 text-left text-sm hover:bg-gray-100 rounded-md cursor-pointer"
              role="menuitem"
              data-testid="logout-button"
            >
              {logout.label}
            </Button>
          </form>
        </div>
      </div>
    ) : (
      <Link
        href={buildRoute(ROUTER.LOGIN, locale)}
        aria-label={login.ariaLabel}
        data-testid="login-link"
      >
        <Button variant="ghost" className="text-sm" data-testid="login-button">
          {login.label}
        </Button>
      </Link>
    )
  }
</div>
