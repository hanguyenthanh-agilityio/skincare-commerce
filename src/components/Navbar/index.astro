---
// Components
import { Link } from '@/components';
import DropdownMenu from '@/components/DropdownMenu';
import DrawerMenu from '@/components/DrawerMenu';

// Constants
import { DROPDOWN_MENU_DATA, NAV_LINKS } from '@/constants';
---

<nav class="flex justify-between h-16 items-center text-sm text-primary">
  {/* Desktop Menu */}
  <div class="hidden md:flex items-center gap-6">
    <DropdownMenu client:load data={DROPDOWN_MENU_DATA} />
    {NAV_LINKS.map((link) => <Link href={link.href}>{link.label}</Link>)}
  </div>

  {/* Mobile Menu */}
  <div class="md:hidden">
    <DrawerMenu client:load data={DROPDOWN_MENU_DATA} navLinks={NAV_LINKS} />
  </div>
</nav>
