---
// Components
import { DrawerMenu, DropdownMenu, Link } from '@/components';

// Constants
import { DROPDOWN_MENU_DATA, NAV_LINKS } from '@/constants';

import { cn } from '@/lib/utils';

interface Props {
  className?: string;
}

const { className = '' } = Astro.props;
---

<nav
  class={cn('flex justify-between items-center text-sm', className)}
  aria-label="Site navigation"
>
  {/* Desktop Menu */}
  <div class="hidden md:flex items-center gap-6">
    <DropdownMenu client:load data={DROPDOWN_MENU_DATA} />
    {NAV_LINKS.map((link) => <Link href={link.href}>{link.label}</Link>)}
  </div>

  {/* Mobile Menu */}
  <div class="md:hidden">
    <DrawerMenu client:load data={DROPDOWN_MENU_DATA} navLinks={NAV_LINKS} />
  </div>
</nav>
