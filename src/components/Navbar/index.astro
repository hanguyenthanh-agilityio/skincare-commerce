---
// Components
import { Link } from '@/components';
import HeaderMenu from '@/components/HeaderMenu';
import MobileMenu from '@/components/MobileMenu';

// Data
import { HeaderMenuData, navLinks } from '@/data/navigation';
---

<nav>
  <div class="flex justify-between h-16 items-center text-sm text-primary">
    {/* Desktop Menu */}
    <div class="hidden md:flex items-center gap-6">
      <HeaderMenu client:load data={HeaderMenuData} />
      {navLinks.map((link) => <Link href={link.href}>{link.label}</Link>)}
    </div>

    {/* Mobile Menu */}
    <div class="md:hidden">
      <MobileMenu data={HeaderMenuData} navLinks={navLinks} client:load />
    </div>
  </div>
</nav>
