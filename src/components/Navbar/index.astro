---
// Components
import { Link } from '@/components';
import DropdownMenu from '@/components/DropdownMenu';
import DrawerMenu from '@/components/DrawerMenu';

// Data
import { DropdownMenuData, navLinks } from '@/data/navigation';
---

<nav class="flex justify-between h-16 items-center text-sm text-primary">
  {/* Desktop Menu */}
  <div class="hidden md:flex items-center gap-6">
    <DropdownMenu client:load data={DropdownMenuData} />
    {navLinks.map((link) => <Link href={link.href}>{link.label}</Link>)}
  </div>

  {/* Mobile Menu */}
  <div class="md:hidden">
    <DrawerMenu client:load data={DropdownMenuData} navLinks={navLinks} />
  </div>
</nav>
