---
// Libs
import { cn } from '@/lib';

// Types
import type { MenuItem, NavLink } from '@/types';

// Components
import { DrawerMenu, DropdownMenu, Link } from '@/components';

interface Props {
  navLinks: NavLink[];
  dropdownMenu: MenuItem[];
  className?: string;
}

const { navLinks, dropdownMenu, className } = Astro.props;
---

<nav
  class={cn('flex justify-between items-center text-sm', className)}
  aria-label="Site navigation"
>
  {/* Desktop Menu */}
  <div class="hidden md:flex items-center gap-6">
    <DropdownMenu client:load data={dropdownMenu} />
    {navLinks.map((link) => <Link href={link.href}>{link.label}</Link>)}
  </div>

  {/* Mobile Menu */}
  <div class="md:hidden">
    <DrawerMenu client:load data={dropdownMenu} navLinks={navLinks} />
  </div>
</nav>
