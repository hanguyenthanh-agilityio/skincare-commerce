---
// Components
import { Link } from '@/components';
import MegaMenu from '@/components/MegaMenu';
import MobileMenu from '@/components/MobileMenu';

// Data
import { megaMenuData, navLinks } from '@/data/navigation';
---

<nav>
  <div class="flex justify-between h-16 items-center text-sm text-primary">
    {/* Desktop Menu */}
    <div class="hidden md:flex items-center gap-6">
      <MegaMenu client:load data={megaMenuData} />
      {navLinks.map((link) => <Link href={link.href}>{link.label}</Link>)}
    </div>

    {/* Mobile Menu */}
    <div class="md:hidden">
      <MobileMenu data={megaMenuData} navLinks={navLinks} client:load />
    </div>
  </div>
</nav>
