---
import { cn } from '@/lib/utils';

interface Props {
  title: string;
  level: 'p' | 'span';
  className?: string;
}

const { level, title, className } = Astro.props;

const Tag = level;

const defaultClasses: Record<string, string> = {
  p: 'text-base/7',
  span: 'text-sm/6',
};
---

<Tag class={cn('text-destructive-foreground', defaultClasses[level], className)}>
  {title}
</Tag>
