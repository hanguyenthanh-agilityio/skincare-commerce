---
// Components
import { Heading, Typography } from '@/components';

// UIs
import { Button } from '@/ui';

interface Props {
  total: string;
  label: string;
  shippingNote: string;
  checkoutText: string;
}
const { total, label, shippingNote, checkoutText } = Astro.props;
---

<aside class="self-start">
  <div class="mb-3 flex items-start justify-between md:gap-10">
    <Heading level="h2" className="text-2xl font-medium" title={label} />
    <div class="text-right">
      <Heading level="h2" className="text-2xl font-medium pb-3" title={`$${total}`} />
      <Typography level="p" className="text-sm text-muted-foreground" title={shippingNote} />
    </div>
  </div>

  <Button className="w-full rounded-none h-14">{checkoutText}</Button>
</aside>
