---
// Components
import { Typography, QuantitySelect, StrapiImage } from '@/components';

// Types
import type { CartItem } from '@/types';

// Utils
import { getCartItemSubtotal } from '@/utils';

interface Props {
  item: CartItem;
}

const { item } = Astro.props as Props;
---

<div
  class="w-full grid grid-cols-6 gap-4 md:gap-0 md:grid-cols-[1fr_120px_140px_120px] lg:grid-cols-[1fr_180px_200px_180px] items-center border-b py-6"
>
  <!-- Product -->
  <div class="col-span-4 md:col-span-1 flex gap-4 items-center">
    <StrapiImage image={item.image} className="h-16 w-12 object-contain" />

    <div>
      <Typography level="p" className="font-bold" title={item.name} />
      <Typography level="span" title={item.volume ?? ''} />
      <!-- Price -->
      <Typography level="span" title={`$${item.price}`} className="md:hidden block" />
    </div>
  </div>

  <!-- Price -->
  <Typography level="span" title={`$${item.price}`} className="hidden md:block" />

  <!-- Quantity (UI only) -->
  <div class="col-span-2 md:col-span-1 flex justify-end md:justify-start">
    <QuantitySelect value={item.quantity} client:idle className="rounded-none bg-white" />
  </div>

  <!-- Subtotal -->
  <Typography level="span" title={`$${getCartItemSubtotal(item)}`} className="hidden md:block" />
</div>
