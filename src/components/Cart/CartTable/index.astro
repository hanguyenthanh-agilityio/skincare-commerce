---
// Components
import { CartHeaderRow, CartItemRow } from '@/components';

// Types
import type { CartItem } from '@/types';

interface Props {
  columns: {
    title: string;
    className?: string;
  }[];
  items: CartItem[];
}

const { columns, items } = Astro.props;
---

<>
  <div class="hidden md:block">
    <CartHeaderRow columns={columns} />
  </div>

  {items.map((item) => <CartItemRow item={item} />)}
</>
