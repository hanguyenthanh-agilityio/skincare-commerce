---
// Constants
import { LOCALES, ROUTER } from '@/constants';

// Types
import type { Locale, StrapiImageType } from '@/types';

// Components
import { Link, Typography, StrapiImage } from '@/components';
import { Icons } from '@/ui';

interface Props {
  documentId: string;
  image: StrapiImageType;
  title: string;
  category: string;
  locale?: Locale;
}

const { documentId, image, title, category, locale } = Astro.props;
---

<div class="w-166 h-350 md:w-331 md:h-461 hover:shadow-lg flex flex-col gap-10 text-left">
  <!-- Product Image + Badge -->
  <StrapiImage image={image} width={166} height={153} className="md:w-331 md:h-72 object-contain" />

  <!-- Blog Info -->
  <div>
    <Typography
      level="span"
      title={category}
      className="text-xs text-quill-grey tracking-[2%] uppercase"
    />

    <Typography
      level="span"
      title={title}
      className="font-bold line-clamp-3 md:line-clamp-2 h-18 md:h-12"
    />
  </div>

  <!-- CTA Button -->
  <Link
    href={`${ROUTER.BLOGS}/${documentId}`}
    ariaLabel={`Go to ${title} blog detail`}
    className="text-left text-sm hover:text-chart-2 hover:underline"
  >
    {locale === LOCALES.EN ? 'Read more' : 'Đọc thêm'}
    <Icons.Arrow />
  </Link>
</div>
