---
// Types
import type { BlogContent, StrapiImageType } from '@/types';

// I18n
import { loadContent } from '@/i18n';

// Components
import { Link, Typography } from '@/components';
import StrapiImage from '@/components/StrapiImage';

// Icons
import { Icons } from '@/ui';

// Constants
import { isLocale, ROUTER } from '@/constants';

interface Props {
  href: string;
  image: StrapiImageType;
  title: string;
  category: string;
}

const { href, image, title, category } = Astro.props;

const rawLocale = Astro.params?.locale ?? 'en';

if (!isLocale(rawLocale)) {
  return Astro.redirect(ROUTER.NOT_FOUND);
}

const blogPage = loadContent<BlogContent>('blog', rawLocale);

const { ctaLabel } = blogPage;
---

<div class="w-166 h-350 md:w-331 md:h-461 hover:shadow-lg flex flex-col gap-10 text-left">
  <!-- Product Image + Badge -->
  <StrapiImage image={image} width={166} height={153} className="md:w-331 md:h-72 object-contain" />

  <!-- Blog Info -->
  <div>
    <Typography
      level="span"
      title={category}
      className="text-xs text-quill-grey-700 tracking-[2%] uppercase"
    />

    <Typography
      level="span"
      title={title}
      className="font-bold line-clamp-3 md:line-clamp-2 h-18 md:h-12"
    />
  </div>

  <!-- CTA Button -->
  <Link
    href={href}
    aria-label={`Go to ${title} blog detail`}
    className="text-left text-sm hover:text-chart-2 hover:underline"
  >
    {ctaLabel}
    <Icons.Arrow />
  </Link>
</div>
