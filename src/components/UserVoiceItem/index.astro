---
// Components
import { Link } from '@/components';
import StrapiImage from '@/components/StrapiImage';

// Icons
import { Icons } from '@/ui';

interface Props {
  src: string;
  link?: string;
}

const { src, link } = Astro.props;
---

<Link href={link ?? '#'} className="group overflow-hidden" ariaLabel="View Instagram post">
  <div class="relative w-32 h-32 md:w-64 md:h-64">
    <StrapiImage
      image={src}
      className="object-cover transition-transform duration-300 group-hover:scale-105"
    />

    <!-- Instagram icon -->
    <div
      class="absolute bottom-2 right-2 text-white pointer-events-none z-50"
      data-testid="instagram-icon"
    >
      <Icons.Instagram aria-hidden="true" className="w-3 h-3 md:w-4.5 md:h-4.5" />
    </div>
  </div>
</Link>
