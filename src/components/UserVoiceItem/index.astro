---
// Components
import { Link, StrapiImage } from '@/components';

// Icons
import { Icons } from '@/ui';

interface Props {
  src: string;
  link?: string;
}

const { src, link } = Astro.props;
---

<Link href={link ?? '#'} className="group overflow-hidden">
  <div class="relative w-64 h-64">
    <StrapiImage
      image={src}
      className="object-cover transition-transform duration-300 group-hover:scale-105"
      client:idle
    />

    <!-- Instagram icon -->
    <div class="absolute bottom-2 right-2 text-white pointer-events-none z-50">
      <Icons.Instagram />
    </div>
  </div>
</Link>
