---
import type { TBlog } from '@/types';

// Components
import { BlogCard, Typography } from '@/components';

interface Props {
  blogs: TBlog[];
  limitDesktop: number;
  limitMobile: number;
}

const { blogs = [], limitDesktop = 4, limitMobile = 2 } = Astro.props;

const displayMobile = blogs.slice(0, Math.max(0, limitMobile));
const displayDesktop = blogs.slice(0, Math.max(0, limitDesktop));

const hasBlogsToDisplay = displayMobile.length > 0 || displayDesktop.length > 0;
---

<div class="w-full">
  {
    !hasBlogsToDisplay ? (
      <Typography
        level="p"
        title="No Blogs Available"
        className="text-center w-full text-gray-500"
      />
    ) : (
      <>
        {/* Mobile */}
        {displayMobile?.length > 0 && (
          <div class="flex md:hidden flex-wrap gap-[3px]">
            {displayMobile.map((blog) => (
              <BlogCard {...blog} />
            ))}
          </div>
        )}

        {/* Desktop */}
        {displayDesktop?.length > 0 && (
          <div class="hidden md:flex flex-wrap gap-[3px]">
            {displayDesktop.map((blog) => (
              <BlogCard {...blog} />
            ))}
          </div>
        )}
      </>
    )
  }
</div>
