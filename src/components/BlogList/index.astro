---
import type { TBlog } from '@/types';

// Components
import { BlogCard } from '@/components';

interface Props {
  blogs: TBlog[];
  limitDesktop: number;
  limitMobile: number;
}

const { blogs, limitDesktop, limitMobile } = Astro.props;

const displayMobile = blogs.slice(0, limitMobile);
const displayDesktop = blogs.slice(0, limitDesktop);
---

<div class="w-full">
  {
    blogs.length === 0 ? (
      <p class="text-center w-full text-gray-500">No Blogs Available</p>
    ) : (
      <>
        {/* Mobile */}
        <div class="flex md:hidden flex-wrap gap-[3px]">
          {displayMobile.map((blog) => (
            <BlogCard {...blog} />
          ))}
        </div>

        {/* Desktop */}
        <div class="hidden md:flex flex-wrap gap-[3px]">
          {displayDesktop.map((blog) => (
            <BlogCard {...blog} />
          ))}
        </div>
      </>
    )
  }
</div>
