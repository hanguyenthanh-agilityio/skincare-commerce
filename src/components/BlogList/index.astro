---
import { cn } from '@/lib';
import { buildRoute } from '@/i18n';

// Types
import type { TBlog } from '@/types';

// Constants
import { ROUTER, type Locale } from '@/constants';

// Components
import { BlogCard, Typography } from '@/components';

interface Props {
  blogs: TBlog[];
  limitDesktop?: number;
  limitMobile?: number;
  locale: Locale;
}

const { blogs, limitDesktop = 4, limitMobile = 2, locale } = Astro.props;

const blogList: TBlog[] = Array.isArray(blogs) ? blogs : [];

const hasBlogs = blogList.length > 0;
---

<div class="w-full my-8">
  {
    !hasBlogs ? (
      <Typography
        level="p"
        title="No Blogs Available"
        className="text-center w-full text-gray-500"
      />
    ) : (
      <div class="flex flex-wrap gap-[3px]">
        {blogList.map((blog, index) => {
          // visibility logic
          const visibleMobile = index < limitMobile;
          const visibleDesktop = index < limitDesktop;

          const visibilityClass = cn(
            visibleMobile ? 'block' : 'hidden',
            visibleDesktop ? 'md:block' : 'md:hidden',
          );

          return (
            <div class={visibilityClass}>
              <BlogCard
                {...blog}
                image={blog.images?.[0]}
                href={buildRoute(ROUTER.BLOGS_DETAIL, locale, { id: blog.documentId })}
              />
            </div>
          );
        })}
      </div>
    )
  }
</div>
