---
import { BlogCard } from '@/components';
import type { TBlog } from '@/types/blogs';

interface Props {
  blogs: TBlog[];
  limitDesktop: number;
  limitMobile: number;
}

const { blogs, limitDesktop, limitMobile } = Astro.props;

// Mobile first
const displayBlogsMobile = blogs.slice(0, limitMobile);
const displayBlogsDesktop = blogs.slice(0, limitDesktop);
---

<div class="w-full">
  <div class="flex flex-wrap gap-4">
    {blogs.length === 0 && <p class="text-center w-full text-gray-500">No Blogs Available</p>}

    {/* Mobile view */}
    <div class="flex md:hidden flex-wrap gap-3.5">
      {
        displayBlogsMobile.map(({ image, name, category, href }) => (
          <BlogCard name={name} href={href} image={image} category={category} />
        ))
      }
    </div>

    {/* Desktop view */}
    <div class="hidden md:flex flex-wrap gap-4">
      {
        displayBlogsDesktop.map(({ image, name, category, href }) => (
          <BlogCard name={name} href={href} image={image} category={category} />
        ))
      }
    </div>
  </div>
</div>
