---
// UIs
import { Button, Icons } from '@/ui';

// Components
import { Link } from '@/components';

// Utils
import { cn } from '@/lib/utils';

interface ActionItem {
  icon: any;
  label: string;
  href?: string;
}

interface Props {
  className?: string;
  actions?: ActionItem[];
}

const defaultActions: ActionItem[] = [
  { icon: Icons.User, label: 'User profile', href: '/profile' },
  { icon: Icons.Cart, label: 'Cart', href: '/cart' },
];

const { className = '', actions = defaultActions } = Astro.props;
---

<nav
  class={cn('flex items-center gap-4 md:gap-10 text-gray-700', className)}
  aria-label="User actions"
>
  {
    actions.map(({ icon: Icon, label, href = '#' }) => (
      <Link href={href} aria-label={label}>
        <Button variant="ghost" size="icon" className="w-3.5 h-3.5" aria-label="Go to profile">
          <Icon width={14} height={14} />
        </Button>
      </Link>
    ))
  }
</nav>
