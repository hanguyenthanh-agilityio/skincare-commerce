{
	"main": "dist/_worker.js/index.js",
	"name": "skincare-e-commerce",
	"compatibility_date": "2025-12-15",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"binding": "ASSETS",
		"directory": "./dist"
	},
	"observability": {
		"enabled": true
	},
	"kv_namespaces": [
		{
			"binding": "SESSION",
			"id": "21fe10c5114845da95d576f5f4ff4eee"
		}
	]
}